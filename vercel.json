{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/openapi.json", "destination": "/openapi.json" },
    { "source": "/((?!api|openapi.json).*)", "destination": "/index.html" }
  ]
}
