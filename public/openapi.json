{
  "openapi": "3.1.0",
  "info": {
    "title": "API Millenium - Gestão de Clientes e Curva ABC",
    "description": "API completa para o ChatGPT consultar em tempo real a carteira de clientes, status (Ativo, Semi-Ativo, Inativo), Curva ABC (A: até 30 dias, B: 31 a 90 dias, C: mais de 90 dias sem comprar), representantes, supervisores e cidades da Millenium.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://millenium-curva-abc.vercel.app",
      "description": "Servidor de Produção (Vercel)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/summary": {
      "get": {
        "operationId": "obterResumoGeral",
        "summary": "Resumo geral da base de clientes e indicadores de desempenho",
        "description": "Retorna métricas consolidadas: total geral de clientes, quantidade e percentual de clientes ativos, semi-ativos e inativos, contagem por faixa da Curva ABC (A, B e C), total de representantes, cidades atendidas e desempenho por setor de supervisão. Use para responder a perguntas sobre o panorama geral da empresa.",
        "responses": {
          "200": {
            "description": "Resumo retornado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalGeralClientes": { "type": "integer" },
                    "resumoStatus": {
                      "type": "object",
                      "properties": {
                        "ativos": { "type": "integer" },
                        "semiAtivos": { "type": "integer" },
                        "inativos": { "type": "integer" },
                        "percentualAtivos": { "type": "number" },
                        "percentualInativos": { "type": "number" }
                      }
                    },
                    "resumoCurvaAbc": {
                      "type": "object",
                      "properties": {
                        "curvaA_ate30dias": { "type": "integer" },
                        "curvaB_31a90dias": { "type": "integer" },
                        "curvaC_mais90dias": { "type": "integer" }
                      }
                    },
                    "metricasGerais": {
                      "type": "object",
                      "properties": {
                        "totalRepresentantes": { "type": "integer" },
                        "totalCidades": { "type": "integer" },
                        "totalSetoresSupervisao": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token inválido ou ausente"
          }
        }
      }
    },
    "/api/clients": {
      "get": {
        "operationId": "consultarClientes",
        "summary": "Consultar e filtrar lista detalhada de clientes",
        "description": "Permite buscar clientes aplicando filtros como termo de busca (razão social, nome fantasia, CNPJ, código), status (Ativo, Semi-Ativo, Inativo), curva ABC (A, B, C), representante comercial, supervisor, cidade, estado e intervalo de dias sem comprar (minDays e maxDays). Retorna código, nomes, endereço, contato, data da última compra e dias de inatividade.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Termo para buscar por Razão Social, Fantasia, CNPJ ou Código",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filtrar por situação do cliente: 'Ativo', 'Semi-Ativo' ou 'Inativo'",
            "required": false,
            "schema": { "type": "string", "enum": ["Ativo", "Semi-Ativo", "Inativo"] }
          },
          {
            "name": "abc",
            "in": "query",
            "description": "Filtrar por classificação da Curva ABC: 'A' (até 30 dias), 'B' (31 a 90 dias) ou 'C' (> 90 dias)",
            "required": false,
            "schema": { "type": "string", "enum": ["A", "B", "C"] }
          },
          {
            "name": "representative",
            "in": "query",
            "description": "Nome ou parte do nome do representante comercial",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "supervisor",
            "in": "query",
            "description": "Setor ou nome do supervisor",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Nome da cidade",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Sigla do estado (UF)",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "minDays",
            "in": "query",
            "description": "Mínimo de dias sem compra (ex: 60 para clientes sem compras há mais de 60 dias)",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "maxDays",
            "in": "query",
            "description": "Máximo de dias sem compra (ex: 30 para compras recentes)",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Quantidade máxima de registros a retornar (padrão 50, máx 200)",
            "required": false,
            "schema": { "type": "integer", "default": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Deslocamento de paginação",
            "required": false,
            "schema": { "type": "integer", "default": 0 }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Campo de ordenação",
            "required": false,
            "schema": { "type": "string", "default": "daysSincePurchase" }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Ordem da classificação",
            "required": false,
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clientes filtrada com metadados de paginação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "retornados": { "type": "integer" },
                    "offset": { "type": "integer" },
                    "limite": { "type": "integer" },
                    "clientes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "codigo": { "type": "string" },
                          "razaoSocial": { "type": "string" },
                          "nomeFantasia": { "type": "string" },
                          "cnpj": { "type": "string" },
                          "cidade": { "type": "string" },
                          "estado": { "type": "string" },
                          "bairro": { "type": "string" },
                          "ramoAtividade": { "type": "string" },
                          "representante": { "type": "string" },
                          "supervisor": { "type": "string" },
                          "status": { "type": "string" },
                          "curvaAbc": { "type": "string" },
                          "diasSemComprar": { "type": "integer" },
                          "dataUltimaCompra": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token inválido ou não informado"
          }
        }
      }
    },
    "/api/representatives": {
      "get": {
        "operationId": "listarRepresentantes",
        "summary": "Obter estatísticas e carteira por representante",
        "description": "Retorna cada representante comercial com total de clientes na sua carteira, contagem de ativos, semi-ativos e inativos, distribuição da Curva ABC e número de cidades atendidas.",
        "responses": {
          "200": {
            "description": "Lista de representantes retornada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalRepresentantes": { "type": "integer" },
                    "representantes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "nome": { "type": "string" },
                          "totalClientes": { "type": "integer" },
                          "ativos": { "type": "integer" },
                          "semiAtivos": { "type": "integer" },
                          "inativos": { "type": "integer" },
                          "curvaA": { "type": "integer" },
                          "curvaB": { "type": "integer" },
                          "curvaC": { "type": "integer" },
                          "quantidadeCidades": { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/cities": {
      "get": {
        "operationId": "listarCidades",
        "summary": "Obter dados consolidados por cidade",
        "description": "Retorna cidades com total de clientes, divisão por status (ativos, semi-ativos, inativos), curva ABC e lista de representantes atuando no município.",
        "responses": {
          "200": {
            "description": "Lista de cidades retornada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalCidades": { "type": "integer" },
                    "cidades": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "cidade": { "type": "string" },
                          "estado": { "type": "string" },
                          "totalClientes": { "type": "integer" },
                          "ativos": { "type": "integer" },
                          "semiAtivos": { "type": "integer" },
                          "inativos": { "type": "integer" },
                          "curvaA": { "type": "integer" },
                          "curvaB": { "type": "integer" },
                          "curvaC": { "type": "integer" },
                          "representantes": {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Token",
        "description": "Informe o Token de API fornecido nas configurações do sistema Millenium."
      }
    }
  }
}
